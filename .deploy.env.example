# Copy this file to .deploy.env and fill values before running deploy script.

# EC2 SSH
EC2_HOST=ec2-xx-xx-xx-xx.ap-southeast-1.compute.amazonaws.com
EC2_USER=ubuntu
EC2_KEY_PATH=/absolute/path/to/your-key.pem
EC2_PORT=22

# Domain for Nginx server_name and final URL
DOMAIN_NAME=your-domain.com

# Spring Boot runtime
APP_PORT=8080
SERVICE_NAME=chatroom
JAVA_PACKAGE=openjdk-21-jre-headless

# Install PostgreSQL on EC2 and initialize DB/user automatically.
# true  = install local PostgreSQL on EC2 (recommended for single-server setup)
# false = use external DB (e.g., AWS RDS)
INSTALL_LOCAL_POSTGRES=true

# Used when INSTALL_LOCAL_POSTGRES=true
POSTGRES_DB=chatroom_db
POSTGRES_USER=chatroom_user
POSTGRES_PASSWORD=change_me

# Optional override for Spring Boot env vars. If omitted and INSTALL_LOCAL_POSTGRES=true,
# script auto-sets:
# DB_URL=jdbc:postgresql://127.0.0.1:5432/${POSTGRES_DB}
# DB_USERNAME=${POSTGRES_USER}
# DB_PASSWORD=${POSTGRES_PASSWORD}
# DB_URL=
# DB_USERNAME=
# DB_PASSWORD=

# Required only when INSTALL_LOCAL_POSTGRES=false
# DB_URL=jdbc:postgresql://your-rds-endpoint:5432/chatroom_db
# DB_USERNAME=postgres
# DB_PASSWORD=change_me

# Optional overrides
# BACKEND_JAR_PATH=/absolute/path/to/chatroom/target/chatroom-0.0.1-SNAPSHOT.jar
# REMOTE_APP_DIR=/opt/chatroom
# REMOTE_WEB_DIR=/var/www/chatroom
# REMOTE_TMP_DIR=/tmp/chatroom-deploy
